@model List<ResultMessageDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Admin/Index.cshtml";
    int count = 0;
}

<div class="container mt-5">

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="bg-primary text-white">
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 25%;">Ad Soyad</th>
                        <th style="width: 25%;">Email</th>
                        <th style="width: 25%;">Konu</th>
                        <th style="width: 20%;" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.Name</td>
                            <td>@item.Email</td>
                            <td>@item.Subject</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">

                                    <a href="#"
                                       class="btn btn-outline-info btn-sm"
                                       title="Oku"
                                       data-bs-toggle="modal"
                                       data-bs-target="#messageModal"
                                       data-id="@item.Id">
                                        <i class="fas fa-envelope-open-text"></i> Mesaj Oku
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="messageModalLabel">Mesaj Detayı: <span id="modalSubject"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="modalBodyContent"></p>
                <hr>
                <small class="text-muted" id="modalSenderInfo"></small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Modal gösterilmeden hemen önce tetiklenir
            $('#messageModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // Tetikleyen buton
                var messageId = button.data('id');  // Butondan mesaj ID'sini al

                // Modal içeriğini temizle ve yükleniyor animasyonu göster
                $('#modalSubject').text('Yükleniyor...');
                $('#modalBodyContent').html('<div class="text-center"><div class="spinner-border text-info" role="status"><span class="visually-hidden">Yükleniyor...</span></div></div>');
                $('#modalSenderInfo').text('');

                // AJAX İsteği: /Admin/Message/Read/ID adresine GET isteği gönder
                $.ajax({
                    type: "GET",
                    url: "/Admin/Message/Read/" + messageId,
                    dataType: "json", // Controller'ın JSON döndürmesini bekliyoruz
                    success: function (data) {
                        // Başarılı yanıt geldiğinde modal içeriğini doldur
                        if (data) {
                            $('#modalSubject').text(data.subject);
                            $('#modalBodyContent').text(data.messageBody); // Veritabanından gelen Body
                            $('#modalSenderInfo').text('Gönderen: ' + data.name + ' (' + data.email + ')');
                        } else {
                            $('#modalSubject').text('Hata');
                            $('#modalBodyContent').text('Mesaj bulunamadı veya API hatası.');
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#modalSubject').text('Bağlantı Hatası');
                        $('#modalBodyContent').text('Mesaj yüklenirken bir sorun oluştu. Detay: ' + xhr.statusText);
                    }
                });
            });
        });
    </script>
}