@model CreateTestimonialDto
@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Admin/Index.cshtml";
}

<h1>Yeni Referans oluştur</h1>

<form method="post">
    <label>Ad Soyad</label>
    <input asp-for="Name" class="form-control" />
    <br />

    <label>Ünvan</label>
    <input asp-for="Title" class="form-control" />
    <br />

    <label>Açıklama</label>
    <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
    <br />

    <div class="mb-4">
        <label asp-for="ImageUrl" class="form-label fw-bold">Görsel URL</label>
        <input type="text" asp-for="ImageUrl" class="form-control" placeholder="Görselin URL adresini girin" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
      
    </div>

    <button class="btn btn-primary">Kaydet</button>

</form>
