@model List<ResultBannerDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Admin/Index.cshtml";
    int count = 0;
}



<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 text-primary">Banner Listesi</h1>

        <a href="/Admin/Banner/Create" class="btn btn-success btn-lg shadow-sm">
            <i class="fas fa-plus-circle"></i> Yeni Banner Ekle
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead class="bg-primary text-white">
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 25%;">Başlık</th>
                        <th style="width: 25%;">Açıklama</th>
                        <th style="width: 25%;">Durum</th>
                        <th style="width: 20%;" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.Title</td>
                            <td><img src="@item.ImageUrl" alt="Banner Görseli" style="width: 128px; height: 128px;" class="img-thumbnail" /></td>
                            <td>@item.Description</td>
                            <td>@(item.IsActive ? "Aktif" :"Pasif")</td>
                            <td class="text-center">
                                <div class="d-inline-flex">

                                    <a href="/Admin/Banner/Delete/@item.Id"
                                       class="btn btn-outline-danger btn-sm"
                                       onclick="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?')"
                                       title="Sil">
                                        <i class="fas fa-trash-alt"></i> Sil
                                    </a>

                                    <a href="/Admin/Banner/Update/@item.Id"
                                       class="btn btn-outline-info btn-sm me-2"
                                       title="Güncelle">
                                        <i class="fas fa-edit"></i> Güncelle
                                    </a>

                                    @if (item.IsActive)
                                    {
                                        <a href="/Admin/Banner/MakePassive/@item.Id"
                                           class="btn btn-danger btn-sm"
                                           title="Pasif Yap">
                                            <i class="fas fa-eye-slash"></i> Pasif Yap
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/Admin/Banner/MakeActive/@item.Id"
                                           class="btn btn-success btn-sm"
                                           title="Aktif Yap">
                                            <i class="fas fa-eye"></i> Aktif Yap
                                        </a>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>



