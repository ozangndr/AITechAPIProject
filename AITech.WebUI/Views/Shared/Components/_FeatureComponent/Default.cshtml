@using AITech.WebUI.DTOs.FeatureDtos
@model List<ResultFeatureDto>
@{
    int count = 0;
}
@*
    Feature
*@


<div class="container-fluid bg-light mt-5 py-5" id="category">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5 wow fadeIn" data-wow-delay="0.1s">
                <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Çözümlerimiz</div>
                <h1 class="mb-4">İşletmeniz İçin Mükemmel Yapay Zeka Çözümlerimiz</h1>
                <p class="mb-4">
                    apay zeka, günümüz iş dünyasının her köşesini yeniden şekillendiriyor. AI.Tech olarak, müşterilerimizin en karmaşık zorluklarını çözmek ve onlara rekabet avantajı sağlamak için en son yapay zeka teknolojilerini kullanarak dönüştürücü projeler geliştiriyoruz.
                </p>
            </div>
            <div class="col-lg-7">
                <div class="row g-4">

                    @foreach (var item in Model)
                    {
                        <div class="col-md-6">
                            <div class="row g-4">
                                <div class="col-12 wow fadeIn" data-wow-delay="0.1s">
                                    <div class="service-item d-flex flex-column justify-content-center text-center rounded">

                                        <div class="service-icon btn-square">
                                            <img src="@item.Icon"
                                                 alt="@item.Title İkonu"
                                                 style="width: 35px; height: 35px; object-fit: contain;">
                                        </div>
                                        <h5 class="mb-3">@item.Title</h5>
                                        <p>
                                            @item.Description
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    }


                </div>
            </div>
        </div>
    </div>
</div>