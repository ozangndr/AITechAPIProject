@using AITech.WebUI.DTOs.AboutDtos
@model ResultAboutDto
@{
    int count = 0;
}
@*
    About
    
*@

<div class="container-fluid py-5" id="about">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.2s">
                <div class="about-img">
                    <img class="img-fluid" src="@Model.ImageUrl">
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <div class="btn btn-sm border rounded-pill text-primary px-3 mb-3">Hakkımızda</div>
                <h1 class="mb-4">@Model.Title</h1>
                <p class="mb-4">
                    @Model.Description
                </p>
                
                <div class="row g-3"> 
                    @foreach (var item in ViewBag.AboutItems)
                    {
                        if (count % 2 == 0)
                        {
                            <div class="col-sm-6">
                                <h6 class="mb-3"><i class="fa fa-check text-primary me-2"></i>@item.Title</h6>
                            </div>
                        }
                        else
                        {
                            <div class="col-sm-6">
                                <h6 class="mb-3"><i class="fa fa-check text-primary me-2"></i>@item.Title</h6>
                            </div>
                        }                        
                    }                   
                </div>
                <div class="d-flex align-items-center mt-4">
                    @foreach (var item in @ViewBag.SocialValues)
                    {
                        <a class="btn btn-outline-primary btn-square me-3" href="@item.Url">

                            <img src="@item.Icon"
                                 alt="Sosyal Medya İkonu"
                                 style="width: 36px;
                            height: 36px;
                            object-fit: cover;
                            border-radius: 50%;">

                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>